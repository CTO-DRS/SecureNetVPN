    <string name="onboarding_title_1">Military-grade privacy</string>
    <string name="onboarding_desc_1">WireGuard® tunneling with ChaCha20-Poly1305 encrypts every packet leaving your device. No logs, no tracking, no compromise.</string>
    <string name="onboarding_title_2">Scan before you trust</string>
    <string name="onboarding_desc_2">The local security auditor reviews installed apps, permissions and files to flag malware, spyware and risky behavior – fully on-device.</string>
