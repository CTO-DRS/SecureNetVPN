<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SecureNet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/surface_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark_bg</item>
        <item name="colorSurfaceVariant">@color/surface_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorError">@color/status_failed</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="materialCardViewStyle">@style/Widget.SecureNet.GlassCard</item>
    </style>

    <style name="Widget.SecureNet.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/corner_glass</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.SecureNet.SurfaceCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_glass</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="TextAppearance.SecureNet.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SecureNet.StatusPill" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Theme.SecureNet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.SecureNet</item>
    </style>
</resources>
