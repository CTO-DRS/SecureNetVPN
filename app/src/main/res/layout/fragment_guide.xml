<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Header: back + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/guide_back_cd"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/on_glass_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/guide_screen_title"
                android:textColor="@color/on_glass_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- v1.8: illustrated 4-step flow -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:id="@+id/flowHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvGuideCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/on_glass_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- v1.8: search -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGuideSearch"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:hint="@string/guide_search_hint"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuideSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- v1.8.20: recent-search chips (سجل البحث الحديث), built
             programmatically into this host — hidden entirely while the
             history is empty. -->
        <LinearLayout
            android:id="@+id/historyHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- v1.8: category filter chips (v1.8.1 adds Favorites) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/guide_filter_all" />

            <!-- v1.8.2: default "top rated" sort as an extra chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTopRated"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_top_rated_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFav"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_favorites_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFree"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_free" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPaid"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_paid" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSelfHosted"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_selfhosted" />

            <!-- v1.8.13: the mesh tools in their own section -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMesh"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_mesh" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRouters"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_routers" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipApps"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_apps" />
        </com.google.android.material.chip.ChipGroup>

        <!-- v1.8.13: quick price filter above the list — All / Free / Paid.
             Independent from the section chips: Free here means every
             source marked free anywhere in the catalog (the free section,
             the free self-hosted and router tools, the mesh tier). -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/priceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriceAll"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/guide_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriceFree"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_price_free" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPricePaid"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_price_paid" />
        </com.google.android.material.chip.ChipGroup>

        <!-- v1.8.17: setup-difficulty filter — All / Beginner / Intermediate /
             Advanced. A third independent row that composes with the section
             chips and the price row; the chips reuse the exact strings of the
             difficulty badge every card has carried since v1.8.14, so the
             filter and the badges always speak the same language. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/difficultyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDifficultyAll"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/guide_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDifficultyBeginner"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_difficulty_beginner" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDifficultyIntermediate"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_difficulty_intermediate" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDifficultyAdvanced"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_difficulty_advanced" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tvGuideEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/guide_no_results"
            android:textColor="@color/on_glass_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Sections + entry cards are built programmatically here -->
        <LinearLayout
            android:id="@+id/guideSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
