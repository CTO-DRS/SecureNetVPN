<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            style="@style/TextAppearance.SecureNet.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/on_glass_primary" />

        <TextView style="@style/SectionTitle" android:text="@string/settings_section_appearance" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme"
                    android:textColor="@color/on_glass_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbThemeSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_system"
                        android:textColor="@color/on_glass_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbThemeLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_light"
                        android:textColor="@color/on_glass_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbThemeDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark"
                        android:textColor="@color/on_glass_primary" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.1: Language / اللغة -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_language"
                        app:tint="@color/on_glass_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_language"
                        android:textColor="@color/on_glass_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rgLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbLangSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_system"
                        android:textColor="@color/on_glass_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbLangEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_english"
                        android:textColor="@color/on_glass_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbLangArabic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_arabic"
                        android:textColor="@color/on_glass_primary" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionTitle" android:text="@string/settings_section_protection" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowBatterySaver">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_battery_saver" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_battery_saver_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBatterySaver"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowAutoBoot">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_auto_boot" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_auto_boot_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoBoot"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowAutoReconnect">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_auto_reconnect" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_auto_reconnect_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoReconnect"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowKillSwitch">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_kill_switch" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_kill_switch_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKillSwitch"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowAutoLaunch">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_auto_launch" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_auto_launch_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoLaunch"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowSmartRules">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_smart_rules" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_smart_rules_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSmartRules"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowTor">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_tor" />
                        <TextView
                            android:id="@+id/tvTorState"
                            style="@style/SettingDesc"
                            android:text="@string/settings_tor_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTor"
                        style="@style/SettingSwitch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionTitle" android:text="@string/settings_section_network" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowSplitTunnel"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_split_tunnel" />
                        <TextView
                            android:id="@+id/tvSplitTunnelState"
                            style="@style/SettingDesc"
                            android:text="@string/split_mode_off" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowDnsCache">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_dns_cache" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_dns_cache_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDnsCache"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowDnsShield">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_dns_shield" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_dns_shield_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDnsShield"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowMtuAuto">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_mtu_auto" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_mtu_auto_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMtuAuto"
                        style="@style/SettingSwitch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.3: Connection schedule -->
        <TextView style="@style/SectionTitle" android:text="@string/settings_section_schedule" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowSchedule"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_schedule" />
                        <TextView
                            android:id="@+id/tvScheduleSummary"
                            style="@style/SettingDesc"
                            android:text="@string/schedule_summary_off" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.4: Advanced networking (multi-hop + hotspot sharing) -->
        <TextView style="@style/SectionTitle" android:text="@string/settings_section_advanced" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowMultiHop"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_multihop" />
                        <TextView
                            android:id="@+id/tvMultiHopState"
                            style="@style/SettingDesc"
                            android:text="@string/multihop_summary_off" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowHotspot"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_hotspot" />
                        <TextView
                            android:id="@+id/tvHotspotState"
                            style="@style/SettingDesc"
                            android:text="@string/hotspot_summary_off" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.6: Always-on VPN + encrypted backup -->
        <TextView style="@style/SectionTitle" android:text="@string/settings_section_persistence" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/SettingRow" android:id="@+id/rowAlwaysOn">
                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_always_on" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_always_on_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAlwaysOn"
                        style="@style/SettingSwitch" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowExportBackup"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_export_backup" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_export_backup_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowImportBackup"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_import_backup" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_import_backup_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>

                <!-- v1.8.3: multiple encrypted backups kept inside the app -->
                <LinearLayout
                    style="@style/SettingRow"
                    android:id="@+id/rowVault"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingTextColumn">
                        <TextView style="@style/SettingTitle" android:text="@string/settings_vault_title" />
                        <TextView style="@style/SettingDesc" android:text="@string/settings_vault_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/on_glass_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.8.23: notification style + lockscreen privacy -->
        <TextView style="@style/SectionTitle" android:text="@string/settings_section_notif" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/SettingRow"
                android:id="@+id/rowNotifStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_notification_shield"
                    app:tint="@color/on_glass_primary" />

                <LinearLayout style="@style/SettingTextColumn">
                    <TextView style="@style/SettingTitle" android:text="@string/settings_row_notif_title" />
                    <TextView style="@style/SettingDesc" android:text="@string/settings_row_notif_sub" />
                    <TextView
                        style="@style/SettingDesc"
                        android:id="@+id/tvNotifState" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/on_glass_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.8: standalone WireGuard config-sources guide -->
        <TextView style="@style/SectionTitle" android:text="@string/settings_section_guide" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/SettingRow"
                android:id="@+id/rowGuide"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_globe"
                    app:tint="@color/on_glass_primary" />

                <LinearLayout style="@style/SettingTextColumn">
                    <TextView style="@style/SettingTitle" android:text="@string/settings_row_guide_title" />
                    <TextView style="@style/SettingDesc" android:text="@string/settings_row_guide_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/on_glass_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.8.20: the 🧭 setup assistant also opens right here, without
             first entering the full guide — same sheet the guide's tools row
             launches, three answers in, ranked shortlist out. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/SettingRow"
                android:id="@+id/rowRecommender"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_auto_awesome"
                    app:tint="@color/on_glass_primary" />

                <LinearLayout style="@style/SettingTextColumn">
                    <TextView style="@style/SettingTitle" android:text="@string/row_recommender_title" />
                    <TextView style="@style/SettingDesc" android:text="@string/row_recommender_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/on_glass_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v1.8.18: support & developer — official contact channels + privacy policy -->
        <TextView style="@style/SectionTitle" android:text="@string/settings_section_support" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/SettingRow"
                android:id="@+id/rowContactDev"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_globe"
                    app:tint="@color/on_glass_primary" />

                <LinearLayout style="@style/SettingTextColumn">
                    <TextView style="@style/SettingTitle" android:text="@string/row_contact_title" />
                    <TextView style="@style/SettingDesc" android:text="@string/row_contact_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/on_glass_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/SettingRow"
                android:id="@+id/rowPrivacyPolicy"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/on_glass_primary" />

                <LinearLayout style="@style/SettingTextColumn">
                    <TextView style="@style/SettingTitle" android:text="@string/row_privacy_title" />
                    <TextView style="@style/SettingDesc" android:text="@string/row_privacy_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/on_glass_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionTitle" android:text="@string/settings_section_data" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLogs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/settings_clear_logs"
                android:textColor="@color/status_failed" />
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/SectionTitle" android:text="@string/settings_section_about" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SecureNet.GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_glass_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/settings_protocol"
                    android:textColor="@color/on_glass_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNativeInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/on_glass_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
