<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass panel: translucent white fill, hairline light stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/corner_glass" />
</shape>
