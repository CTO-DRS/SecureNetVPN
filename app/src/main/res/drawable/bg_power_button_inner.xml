<?xml version="1.0" encoding="utf-8"?>
<!-- Inner disc of the activation button -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="160dp"
        android:startColor="#33FFFFFF"
        android:centerColor="#22FFFFFF"
        android:endColor="#11FFFFFF" />
    <stroke
        android:width="1.5dp"
        android:color="@color/power_button_stroke" />
</shape>
