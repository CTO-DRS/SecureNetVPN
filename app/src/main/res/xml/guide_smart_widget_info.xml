<?xml version="1.0" encoding="utf-8"?>
<!-- v1.8.11 — Smart picks widget metadata: three stacked rows fit a
     3×2 cell footprint; the system refresh floor is 30 minutes, and any
     user-signal change repaints sooner via the provider's pushUpdate. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialKeyguardLayout="@layout/widget_smart_picks"
    android:initialLayout="@layout/widget_smart_picks"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_smart_picks_description" />
