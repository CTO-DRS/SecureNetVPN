<?xml version="1.0" encoding="utf-8"?>
<!--
  Security-first backup policy: nothing may leave the device through OS
  backups because encrypted preference files and tunnel logs are only
  meaningful on-device (and keys must never migrate).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
